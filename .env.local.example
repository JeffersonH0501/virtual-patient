# Local PostgreSQL. These values are only for the Docker network on this machine.
POSTGRES_DB=virtual_patient
POSTGRES_USER=postgres
POSTGRES_PASSWORD=virtual_patient_local
POSTGRES_PORT=5432

# Change this value if local sessions must survive recreation of the containers.
SECRET_KEY=local-development-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480

# The database setup process provisions exactly one superuser from these values.
SUPERUSER_EMAIL=local.superuser@example.com
SUPERUSER_FIRST_NAME=Local
SUPERUSER_LAST_NAME=Superuser
SUPERUSER_PASSWORD=local-superuser-change-me
SUPERUSER_PREFERRED_LANGUAGE=es

# Azure OpenAI v1 is required for AI conversations, embeddings, TTS and STT checks.
# The placeholders let the API boot and allow non-AI flows to be verified.
AZURE_OPENAI_API_KEY=local-not-configured
AZURE_OPENAI_ENDPOINT=https://example.invalid
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_LLM_DEPLOYMENT_NAME=local-not-configured
AZURE_OPENAI_LLM_MINI_DEPLOYMENT_NAME=local-not-configured
AZURE_OPENAI_STT_DEPLOYMENT_NAME=local-not-configured
AZURE_OPENAI_TTS_DEPLOYMENT_NAME=local-not-configured
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=local-not-configured

# Private interview media storage. No automatic deletion is performed yet.
MEDIA_STORAGE_ROOT=/app/media
MEDIA_RETENTION_DAYS=
MEDIA_CONSENT_POLICY_VERSION=institutional-v1
MEDIA_DURATION_TOLERANCE_MS=500
MEDIA_MIN_FREE_BYTES=268435456

# Temporary diagnostic timing logs for patient-response generation.
PATIENT_RESPONSE_TIMING_LOGGING=false

# UI. This is Google's public reCAPTCHA v2 test site key for localhost testing.
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
VITE_API_HOST=http://127.0.0.1
VITE_API_PORT=8000
VITE_SPEECH_INPUT_PROVIDER=server
