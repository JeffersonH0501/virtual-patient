# PostgreSQL Database
POSTGRES_DB=virtual_patient
POSTGRES_USER=postgres
POSTGRES_PASSWORD=virtual_patient_local
POSTGRES_PORT=5432

# JWT authentication
SECRET_KEY=local-development-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Azure OpenAI
AZURE_OPENAI_API_KEY=local-not-configured
AZURE_OPENAI_ENDPOINT=https://example.invalid
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_LLM_DEPLOYMENT_NAME=local-not-configured
AZURE_OPENAI_LLM_MINI_DEPLOYMENT_NAME=local-not-configured
AZURE_OPENAI_STT_DEPLOYMENT_NAME=local-not-configured
AZURE_OPENAI_TTS_DEPLOYMENT_NAME=local-not-configured
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=local-not-configured

# Superuser account
SUPERUSER_EMAIL=superuser@example.com
SUPERUSER_PASSWORD=local-superuser-change-me
SUPERUSER_NAME=Super User

# UI. This is Google's public reCAPTCHA v2 test site key for localhost testing.
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
VITE_API_HOST=http://localhost
VITE_API_PORT=8000
VITE_SPEECH_INPUT_PROVIDER=server

# Simli AI Avatar Integration
SIMLI_AVATAR_ENABLED=false
SIMLI_API_KEY=
SIMLI_API_URL=https://api.simli.ai
SIMLI_DEFAULT_FACE_ID_MALE=
SIMLI_DEFAULT_FACE_ID_FEMALE=
SIMLI_MAX_SESSION_LENGTH=1800
SIMLI_MAX_IDLE_TIME=300
