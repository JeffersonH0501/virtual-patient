{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"],
  // Test files are excluded from the production build. No test runner is
  // configured yet (no `vitest`/`jest` dependency), so co-located `*.test.ts`
  // files import a runner module that is not installed; excluding them keeps
  // `tsc -b && vite build` green while leaving the tests ready to run once a
  // runner (vitest, matching this Vite project) is added.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
