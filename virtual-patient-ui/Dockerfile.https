FROM node:20-alpine as build

WORKDIR /app

# Enable corepack and set up the correct Yarn version
RUN corepack enable && corepack prepare yarn@4.6.0 --activate

# Copy package files first (for better layer caching)
COPY package.json yarn.lock .yarnrc.yml ./

# Copy .yarn directory if it exists (required for Yarn Berry)
COPY .yarn ./.yarn

# Install dependencies
RUN yarn install

# Copy the rest of your application
COPY . .

# Build with environment variables
ARG VITE_RECAPTCHA_SITE_KEY
ENV VITE_RECAPTCHA_SITE_KEY=${VITE_RECAPTCHA_SITE_KEY}
ARG VITE_API_HOST
ENV VITE_API_HOST=${VITE_API_HOST}
ARG VITE_API_PORT
ENV VITE_API_PORT=${VITE_API_PORT}

# Build the application
RUN yarn build

# Production stage
FROM nginx:alpine

# Install curl for health checks
RUN apk add --no-cache curl

# Copy built files from build stage to nginx server
COPY --from=build /app/dist /usr/share/nginx/html

# Copy HTTPS nginx configuration
COPY nginx-https-working.conf /etc/nginx/conf.d/default.conf

# Add health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost/ || exit 1

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
