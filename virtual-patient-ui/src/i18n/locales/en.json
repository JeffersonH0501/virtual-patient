  "help": {
    "title": "Information",
    "purpose": {
      "title": "Purpose",
      "description": "This Virtual Patient is an interactive educational tool designed to train medical students in clinical interviewing and communication skills."
    },
    "objective": {
      "title": "Objective",
      "description": "Through simulated conversations with virtual patients, users can practice taking anamnesis and receive automated feedback on their performance. The experience strengthens clinical communication skills and the rigorous collection of medical information in a safe, realistic, and patient-centered environment."
    },
    "howItWorks": {
      "title": "How It Works",
      "step1": "Select a clinical case from the available scenarios",
      "step2": "Conduct a virtual interview with the AI-powered patient, asking questions and gathering information",
      "step3": "Submit your clinical hypotheses based on the information gathered during the interview",
      "step4": "Receive detailed evaluation and feedback on your performance, including communication skills and diagnostic accuracy"
    },
    "clinicalCases": {
      "title": "Clinical cases",
      "description": "The platform offers a variety of clinical cases covering different medical specialties and difficulty levels:",
      "feature1": "Pre-built cases covering common medical conditions and scenarios",
      "feature2": "Custom case creation for specific learning objectives. This functionality is available for users with teacher role.",
      "feature3": "AI-powered patients with realistic personalities and responses",
      "feature4": "Comprehensive evaluation and feedback system"
    },
    "additionalInfo": {
      "description": "This platform is developed by Universidad de los Andes, Colombia, as part of a research project in the Department of Systems and Computer Engineering. It utilizes AI technology to create realistic patient interactions and provide comprehensive educational feedback."
    }
  }
