# Copy this file to .env.full and replace every change-me value.
POSTGRES_DB=virtual_patient
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-database-password

SECRET_KEY=change-me-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

AZURE_OPENAI_API_KEY=change-me
AZURE_OPENAI_ENDPOINT=https://change-me.openai.azure.com
AZURE_OPENAI_LLM_DEPLOYMENT_NAME=change-me
AZURE_OPENAI_LLM_MINI_DEPLOYMENT_NAME=change-me
AZURE_OPENAI_STT_DEPLOYMENT_NAME=change-me
AZURE_OPENAI_TTS_DEPLOYMENT_NAME=change-me
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=change-me

VITE_RECAPTCHA_SITE_KEY=change-me
HTTP_PORT=80
HTTPS_PORT=443

# Optional integrations
GCS_BUCKET_NAME=
GCS_CREDENTIALS_PATH=
