# Copy this file to .env.full and replace every change-me value.
POSTGRES_DB=virtual_patient
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-database-password

SECRET_KEY=change-me-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# The database setup process provisions exactly one superuser from these values.
SUPERUSER_EMAIL=change-me-superuser@example.com
SUPERUSER_FIRST_NAME=change-me-first-name
SUPERUSER_LAST_NAME=change-me-last-name
SUPERUSER_PASSWORD=change-me-superuser-password
SUPERUSER_PREFERRED_LANGUAGE=es

AZURE_OPENAI_API_KEY=change-me
AZURE_OPENAI_ENDPOINT=https://change-me.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_LLM_DEPLOYMENT_NAME=change-me
AZURE_OPENAI_LLM_MINI_DEPLOYMENT_NAME=change-me
AZURE_OPENAI_STT_DEPLOYMENT_NAME=change-me
AZURE_OPENAI_TTS_DEPLOYMENT_NAME=change-me
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=change-me

SPEECH_TTS_PROVIDER=azure_openai
SPEECH_STT_PROVIDER=azure_openai

VITE_RECAPTCHA_SITE_KEY=change-me
VITE_SPEECH_INPUT_PROVIDER=server
HTTP_PORT=80
HTTPS_PORT=443

# Optional integrations
GCS_BUCKET_NAME=
GCS_CREDENTIALS_PATH=

# Private interview media storage. Back up the Docker volume separately.
MEDIA_STORAGE_ROOT=/app/media
MEDIA_RETENTION_DAYS=
MEDIA_CONSENT_POLICY_VERSION=institutional-v1
MEDIA_DURATION_TOLERANCE_MS=500
MEDIA_MIN_FREE_BYTES=268435456

# Temporary diagnostic timing logs for patient-response generation.
PATIENT_RESPONSE_TIMING_LOGGING=false

# OpenSMILE extraction for student turns (infrastructure enable flag).
# NOTE: the multimodal pipeline reads its methodology parameters (min_pause_ms,
# min_voiced_duration_ms) from app/multimodal/config/processing.yaml, not here.
# These provisional processing parameters are not clinical performance cutoffs.
PARAVERBAL_ANALYSIS_ENABLED=true
PARAVERBAL_MIN_PAUSE_MS=200
PARAVERBAL_MIN_VOICED_DURATION_MS=300

# Py-Feat v2 extraction for student video (infrastructure).
# Enable flag, device, weights path, and sampling infrastructure stay here.
# NOTE: methodology values (gaze alignment tolerance, AU12 active threshold, nod
# detector parameters) now live in app/multimodal/config/processing.yaml and
# remain null until the research procedure is defined; the values below are no
# longer read by the pipeline for that purpose.
PYFEAT_ANALYSIS_ENABLED=true
PYFEAT_DEVICE=cpu
PYFEAT_WEIGHTS_ROOT=/app/pyfeat/weights
PYFEAT_SAMPLE_FPS=2
PYFEAT_GAZE_ALIGNMENT_MAX_RADIANS=
PYFEAT_AU12_ACTIVE_THRESHOLD=
