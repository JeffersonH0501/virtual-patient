# Copy this file to .env.full and replace every change-me value.
POSTGRES_DB=virtual_patient
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-database-password

SECRET_KEY=change-me-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

AZURE_OPENAI_API_KEY=change-me
AZURE_OPENAI_ENDPOINT=https://change-me.openai.azure.com
AZURE_OPENAI_LLM_DEPLOYMENT_NAME=change-me
AZURE_OPENAI_LLM_MINI_DEPLOYMENT_NAME=change-me
AZURE_OPENAI_STT_DEPLOYMENT_NAME=change-me
AZURE_OPENAI_TTS_DEPLOYMENT_NAME=change-me
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=change-me

SPEECH_TTS_PROVIDER=azure_openai
SPEECH_STT_PROVIDER=disabled

VITE_RECAPTCHA_SITE_KEY=change-me
VITE_SPEECH_INPUT_PROVIDER=browser
HTTP_PORT=80
HTTPS_PORT=443

# Optional integrations
GCS_BUCKET_NAME=
GCS_CREDENTIALS_PATH=

# Private interview media storage. Back up the Docker volume separately.
MEDIA_STORAGE_ROOT=/app/media
MEDIA_RETENTION_DAYS=
MEDIA_CONSENT_POLICY_VERSION=institutional-v1
MEDIA_DURATION_TOLERANCE_MS=500
MEDIA_MIN_FREE_BYTES=268435456

# Temporary diagnostic timing logs for patient-response generation.
PATIENT_RESPONSE_TIMING_LOGGING=false

# Research-only OpenSMILE extraction for student turns. These thresholds are
# provisional processing parameters, not clinical performance cutoffs.
PARAVERBAL_ANALYSIS_ENABLED=true
PARAVERBAL_MIN_PAUSE_MS=200
PARAVERBAL_MIN_VOICED_DURATION_MS=300

# Research-only OpenFace 3.0 extraction for student video. Download the
# upstream model weights into OPENFACE_WEIGHTS_ROOT before enabling it. The
# calibration and AU12 mapping values intentionally default to empty.
NONVERBAL_ANALYSIS_ENABLED=true
OPENFACE_DEVICE=cpu
OPENFACE_WEIGHTS_ROOT=/app/openface/weights
OPENFACE_SAMPLE_FPS=2
OPENFACE_GAZE_ALIGNMENT_MAX_RADIANS=
OPENFACE_AU12_INDEX=
OPENFACE_AU12_ACTIVE_THRESHOLD=

# Secondary Py-Feat v2 benchmark. It is stored separately from OpenFace and
# uses the same private student video and common interview clock.
PYFEAT_ANALYSIS_ENABLED=false
PYFEAT_DEVICE=cpu
PYFEAT_SAMPLE_FPS=2
PYFEAT_GAZE_ALIGNMENT_MAX_RADIANS=
PYFEAT_AU12_ACTIVE_THRESHOLD=

# Azure AI Speech Avatar Validation Pilot (Report Section 4.4)
AVATAR_PILOT_ENABLED=false
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus2
AZURE_SPEECH_AVATAR_CHARACTER_FEMALE=lisa
AZURE_SPEECH_AVATAR_CHARACTER_MALE=jeff
AZURE_SPEECH_AVATAR_IDLE_OPTIMIZATION=true
VITE_AVATAR_PILOT_ENABLED=false
